-- Register a widget definition (host API)
function WidgetEngine.register(def)
    if type(def) ~= "table" then return nil end
    def.Id = def.Id or Utils.id("widget")
    def.Title = def.Title or def.Id
    def.Description = def.Description or ""
    def.DefaultSize = def.DefaultSize or { Columns = 1, Rows = 1 }
    WidgetEngine.registry[def.Id] = def
    return def.Id
end

-- Build built-in widgets only after register is available
buildBuiltinWidgets()

function WidgetEngine.get(id)
    return WidgetEngine.registry[id]
end

function WidgetEngine.catalog()
    local out = {}
    for _, def in pairs(WidgetEngine.registry) do table.insert(out, def) end
    table.sort(out, function(a, b) return a.Title < b.Title end)
    return out
end

-- Enable the dashboard (creates a dedicated host-visible tab)
function WidgetEngine.enable(window)
    WidgetEngine.enabled = true
    WidgetEngine.window = window
    if not WidgetEngine.dashboardTab or WidgetEngine.dashboardTab.destroyed then
        WidgetEngine.dashboardTab = window:Tab({ Id = "dashboard", Title = "Dashboard", Icon = "layout" })
        local sec = WidgetEngine.dashboardTab:Section({ Title = "Widgets", Id = "dashboard-widgets" })
        WidgetEngine.dashboardSection = sec
    end
    WidgetEngine.loadLayout()
    WidgetEngine.renderAll()
end

function WidgetEngine.disable()
    WidgetEngine.enabled = false
    WidgetEngine.renderAll()
end

-- Create a widget instance on the dashboard
function WidgetEngine.add(widgetDefId, config)
    if not WidgetEngine.enabled then return nil end
    local def = WidgetEngine.registry[widgetDefId]
    if not def then return nil end
    config = config or {}
    local instanceId = config.Id or Utils.id("wi")
    if WidgetEngine.instances[instanceId] then return instanceId end

    local section = WidgetEngine.dashboardSection:Section({ Title = def.Title, Id = "w_" .. instanceId })
    local ctx = {
        id = instanceId,
        theme = Theme.Current,
        state = config,
        visible = true,
        onTick = nil,
        destroy = function() WidgetEngine.remove(instanceId) end,
    }
    local node = nil
    local ok, result = pcall(function() return def.Render and def.Render(ctx) end)
    if ok and result then
        node = result
        section.container.Parent = section.container.Parent
        -- place rendered node inside the section body
        if node:IsA("GuiObject") then node.Parent = section.container end
    else
        -- error fallback: widget shows an error state instead of breaking the page
        local err = Utils.make("TextLabel", {
            Size = UDim2.new(1, 0, 0, 32),
            BackgroundTransparency = 1,
            Text = "Widget indisponível: " .. tostring(result),
            TextColor3 = Theme.Current.palette.error,
            Font = Theme.Current.typography.font,
            TextSize = 12,
            TextWrapped = true,
            ZIndex = 18,
        }, section.container)
        node = err
    end

    WidgetEngine.instances[instanceId] = {
        def = def,
        config = config,
        section = section,
        node = node,
        ctx = ctx,
    }
    table.insert(WidgetEngine.order, instanceId)
    WidgetEngine.saveLayout()
    return instanceId
end

function WidgetEngine.remove(instanceId)
    local w = WidgetEngine.instances[instanceId]
    if not w then return end
    if w.def and w.def.Destroy then pcall(w.def.Destroy, w.ctx) end
    pcall(function() w.section:Destroy() end)
    WidgetEngine.instances[instanceId] = nil
    for i, id in ipairs(WidgetEngine.order) do
        if id == instanceId then table.remove(WidgetEngine.order, i) break end
    end
    WidgetEngine.saveLayout()
end

function WidgetEngine.move(instanceId, direction)
    local idx = nil
    for i, id in ipairs(WidgetEngine.order) do if id == instanceId then idx = i break end end
    if not idx then return false end
    local target = idx + direction
    if target < 1 or target > #WidgetEngine.order then return false end
    WidgetEngine.order[idx], WidgetEngine.order[target] = WidgetEngine.order[target], WidgetEngine.order[idx]
    WidgetEngine.renderAll()
    WidgetEngine.saveLayout()
    return true
end

function WidgetEngine.renderAll()
    if not WidgetEngine.enabled then return end
    -- Reorder existing sections to match WidgetEngine.order
    for _, w in pairs(WidgetEngine.instances) do
        if w.section and w.section.instance then
            local order = 0
            for i, id in ipairs(WidgetEngine.order) do
                if id == w.instanceId then order = i break end
            end
            w.section.instance.LayoutOrder = order
        end
    end
end

function WidgetEngine.saveLayout()
    Persist.write("widgets", { order = WidgetEngine.order })
end

function WidgetEngine.loadLayout()
    local data = Persist.read("widgets")
    if data and data.order then
        WidgetEngine.order = data.order
    end
end

