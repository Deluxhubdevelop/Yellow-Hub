    WindowMgr.focus(self)
    Search.installHotkey(self)

    -- Initial fade-in
    main.BackgroundTransparency = 1
    shadow.BackgroundTransparency = 1
    gui.Parent = container
    Motion.animate(main, { BackgroundTransparency = Theme.Current.glass.opacity }, Motion.duration("Emphasis"))
    Motion.animate(shadow, { BackgroundTransparency = 0.5 }, Motion.duration("Emphasis"))

    return self
end

function Window:setTitle(text)
    self.title = text
    local tLbl = self.gui:FindFirstChild("TitleLabel", true)
    if tLbl then tLbl.Text = text end
end

function Window:setTheme(theme)
    Theme.apply(theme)
    self:refreshTheme()
end

function Window:refreshTheme()
    local t = Theme.Current
    Utils.set(self.main, "BackgroundColor3", t.palette.background)
    Utils.set(self.main, "BackgroundTransparency", t.glass.opacity)
    -- Components read Theme.Current at render; no full rebuild needed
end

function Window:setGlass(material)
    Glass.material(material)
    self:refreshTheme()
end

function Window:setQuality(level)
    Theme.Quality = level
    Theme.Current.glass.material = (level == "Eco") and "Solid" or Theme.Current.glass.material
    self:refreshTheme()
end

function Window:setMotion(preset)
    Theme.Motion = preset
    Theme.Current.motion.preset = preset
end

function Window:setWindowMode(mode)
    self.opts.Window = self.opts.Window or {}
    self.opts.Window.mode = mode
end

function Window:setMinimizeMode(mode)
    self.opts.Minimize = self.opts.Minimize or {}
    self.opts.Minimize.mode = mode
end

function Window:Notify(opts)
    return Notify.create(opts)
end

function Window:OpenCommandPalette()
    Search.openPalette(self)
end

function Window:OpenThemeStudio()
    ThemeStudio.open(self)
end

function Window:GoTo(tabId)
    local tab = self.tabs[tabId]
    if tab then tab:Select() end
end

function Window:Destroy()
    if self.destroyed then return end
    self.destroyed = true
    Motion.cancel(self.main)
    Motion.cancel(self.shadow)
    for _, tab in pairs(self.tabs) do
        pcall(function() tab:Destroy() end)
    end
    self.tabs = {}
    self.tabOrder = {}
    pcall(function() self.gui:Destroy() end)
    pcall(function() self.minGui:Destroy() end)
    WindowMgr.windows[self.id] = nil
    if WindowMgr.focused == self then WindowMgr.focused = nil end
end

Window.destroy = Window.Destroy

