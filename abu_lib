function Tab.new(window, opts)
    opts = opts or {}
    local id = opts.Id or opts.id or Utils.id("tab")
    local self = setmetatable({}, Tab)
    self.id = id
    self.window = window
    self.opts = opts
    self.title = opts.Title or opts.Name or "Aba"
    self.icon = opts.Icon or ""
    self.desc = opts.Description or ""
    self.sections = {}
    self.controls = {}
    self.visible = true

    local nav = window.containers.nav
    local btn = Utils.make("TextButton", {
        Name = "Tab_" .. id,
        Size = UDim2.new(1, 0, 0, 46),
        BackgroundColor3 = Theme.Current.palette.panel,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 17,
    }, nav)
    Utils.corner(btn, 10)
    Utils.stroke(btn, Theme.Current.palette.border, 0.3, 1)

    local marker = Utils.make("Frame", {
        Position = UDim2.fromOffset(0, 10),
        Size = UDim2.fromOffset(4, 26),
        BackgroundColor3 = Theme.Current.palette.accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 18,
    }, btn)
    Utils.corner(marker, 2)

    local icHolder = Utils.make("Frame", {
        Position = UDim2.fromOffset(12, 12),
        Size = UDim2.fromOffset(22, 22),
        BackgroundTransparency = 1,
        ZIndex = 18,
    }, btn)
    if self.icon and self.icon ~= "" then
        Icons.draw(icHolder, self.icon, 18, Theme.Current.palette.icon)
    end

    local tLbl = Utils.make("TextLabel", {
        Position = UDim2.fromOffset(44, 0),
        Size = UDim2.new(1, -56, 1, 0),
        BackgroundTransparency = 1,
        Text = self.title,
        TextColor3 = Theme.Current.palette.textMuted,
        Font = Theme.Current.typography.font,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 18,
    }, btn)
    themePart(btn, "surface")
    themePart(tLbl, "muted")
    themePart(marker, "accent")
    Motion.hover(btn, Theme.Current.palette.hover, Theme.Current.palette.panel)

    -- Page content
    local page = window.containers.page
    local sectionFlow = Utils.make("Frame", {
        Name = "TabContent_" .. id,
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 15,
    }, page)
    local flowList = Utils.list(sectionFlow, 10)

    self.instance = btn
    self.marker = marker
    self.titleLabel = tLbl
    self.content = sectionFlow
    self.flowList = flowList

    function self:Select()
        if window.currentTab == self then return end
        if window.currentTab then window.currentTab:Deselect() end
        window.currentTab = self
        for _, t in pairs(window.tabs) do
            Utils.set(t.instance, "BackgroundColor3", Theme.Current.palette.panel)
            Utils.set(t.marker, "BackgroundTransparency", 1)
            Utils.set(t.titleLabel, "TextColor3", Theme.Current.palette.textMuted)
            t.content.Visible = false
        end
        Utils.set(btn, "BackgroundColor3", Theme.Current.palette.surface)
        Utils.set(marker, "BackgroundTransparency", 0)
        Utils.set(tLbl, "TextColor3", Theme.Current.palette.accent)
        sectionFlow.Visible = true
        window.containers.empty.Visible = false
        window.containers.pageTitle.Text = self.title
        window.containers.pageSub.Text = self.desc
        sectionFlow.Position = UDim2.new(0, 10, 0, 0)
        Motion.animate(sectionFlow, { Position = UDim2.new(0, 0, 0, 0) }, Motion.duration("Navigation"))
        WindowMgr.focus(window)
    end

    function self:Deselect()
        sectionFlow.Visible = false
    end

    function self:Destroy()
        for _, s in pairs(self.sections) do pcall(function() s:Destroy() end) end
        pcall(function() btn:Destroy() end)
        pcall(function() sectionFlow:Destroy() end)
        Search.unregister("tab:" .. self.id)
        for sid in pairs(self._sectionIds or {}) do Search.unregister("section:" .. sid) end
        window.tabs[self.id] = nil
        for i, tid in ipairs(window.tabOrder) do
            if tid == self.id then table.remove(window.tabOrder, i) break end
        end
    end

    Tab.destroy = self.Destroy

    btn.Activated:Connect(function() self:Select() end)

    window.tabs[id] = self
    table.insert(window.tabOrder, id)
    if #window.tabOrder == 1 then self:Select() end

    Search.register({
        id = "tab:" .. id,
        title = self.title,
        desc = self.desc ~= "" and self.desc or "Aba",
        keywords = table.concat({ self.title, self.desc or "", id }, " "),
        aliases = id,
        tabId = id,
        type = "tab",
    })
    return self
end

function Tab:Section(opts)
    if type(opts) == "string" then opts = { Title = opts } end
    return Section.new(self, opts)
end

-- Generic component shortcut on Tab
function Tab:_comp(kind, ...)
    local args = {...}
    local section = self.sections[next(self.sections)] or Section.new(self, { Title = "Controles" })
    local body = section.container
    local first = args[1]
    local opts, cb
    if type(first) == "string" then
        opts = { Title = first }
        cb = args[2]
    else
        opts = first
        cb = args[2]
    end
    if type(opts) == "table" then
        opts.__tabId = self.id
        opts.__sectionId = section.id
    end
    local comp = Components.resolve(kind)
    if not comp then
        warn("[limui] component type not found: " .. tostring(kind))
        return nil
    end
    return comp(body, opts, cb)
end

for _, k in ipairs({"Button","Toggle","Slider","Dropdown","Input","ColorPicker","Keybind","Label","Separator","Paragraph","Card"}) do
    Tab[k] = function(self, ...) return self:_comp(k, ...) end
end

