Control = {}
Control.controls = {}

function Control.new(id, kind, instance, getValue, setValue, opts)
    opts = opts or {}
    local c = {
        id = id, kind = kind, instance = instance,
        getValue = getValue or function() return nil end,
        setValue = setValue or function() end,
        opts = opts,
        disabled = false, visible = true, destroyed = false,
    }
    Control.controls[id] = c
    if opts.Searchable ~= false then
        local title = opts.Title or opts.Name or opts.Text or id
        local kw = opts.Keywords or opts.KeywordsList or opts.Tags or ""
        if type(kw) == "table" then kw = table.concat(kw, " ") end
        Search.register({
            id = "control:" .. id,
            title = tostring(title),
            desc = tostring(opts.Description or ""),
            keywords = tostring(title) .. " " .. tostring(kw),
            aliases = tostring(opts.Aliases or ""),
            tabId = opts.__tabId,
            sectionId = opts.__sectionId,
            controlId = id,
            type = kind,
        })
    end
    return c
end

function Control.get(id) return Control.controls[id] end

function Control:setDisabled(disabled)
    self.disabled = disabled
    if self.instance then
        Utils.set(self.instance, "Active", not disabled)
        Utils.set(self.instance, "AutoButtonColor", not disabled)
        local alpha = disabled and 0.5 or 0
        for _, desc in ipairs(self.instance:GetDescendants()) do
            if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
                pcall(function() desc.TextTransparency = alpha end)
            end
        end
    end
end

function Control:setVisible(visible)
    self.visible = visible
    if self.instance then self.instance.Visible = visible end
end

function Control:setTitle(text)
    if self.instance and text then
        for _, desc in ipairs(self.instance:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Name == "TitleLabel" then
                desc.Text = text
                break
            end
        end
    end
end

function Control:destroy()
    if self.destroyed then return end
    self.destroyed = true
    Control.controls[self.id] = nil
    Search.unregister("control:" .. self.id)
    if self.instance then
        Motion.cancel(self.instance)
        pcall(function() self.instance:Destroy() end)
    end
end

-- Alias for compatibility
Control.Destroy = Control.destroy

