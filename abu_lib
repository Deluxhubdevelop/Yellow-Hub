function Components.TextArea(parent, opts, onChanged)
    opts = opts or {}
    local id = opts.Id or Utils.id("textarea")
    local title = opts.Title or opts.Name or "Área de texto"
    local placeholder = opts.Placeholder or "Digite aqui..."
    local default = opts.Default or ""
    local callback = opts.Callback or onChanged or function() end

    local container = Utils.make("Frame", {
        Size = UDim2.new(1, 0, 0, 100),
        BackgroundTransparency = 1,
        ZIndex = 18,
    }, parent)
    Utils.list(container, 6)

    if title and title ~= "" then
        makeLabel(container, title, UDim2.new(1, 0, 0, 16), Theme.Current.palette.text, nil, nil)
    end

    local box = Utils.make("TextBox", {
        Size = UDim2.new(1, 0, 0, 80),
        BackgroundColor3 = Theme.Current.palette.surface,
        Text = default,
        PlaceholderText = placeholder,
        PlaceholderColor3 = Theme.Current.palette.placeholder,
        TextColor3 = Theme.Current.palette.text,
        Font = Theme.Current.typography.font,
        TextSize = 13,
        ClearTextOnFocus = false,
        BorderSizePixel = 0,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 18,
    }, container)
    Utils.corner(box, Theme.Current.shape.radiusButton)
    Utils.stroke(box, Theme.Current.palette.border, 0.3, 1)
    Utils.pad(box, 8, 10, 8, 10)

    box.FocusLost:Connect(function(enter)
        Utils.call(callback, box.Text)
    end)

    local handle = Control.new(id, "textarea", box, function() return box.Text end, function(v)
        box.Text = tostring(v or "")
    end, opts)
    handle.setValue = function(v, silent)
        box.Text = tostring(v or "")
        if not silent then Utils.call(callback, box.Text) end
        return handle
    end
    handle.getValue = function() return box.Text end
    handle.setDisabled = function(d) Utils.set(box, "Editable", not d) end
    handle.setVisible = function(v) Control.setVisible(handle, v) end
    handle.focus = function() box:CaptureFocus() end
    handle.destroy = function() Control.destroy(handle) end
    handle.Destroy = handle.destroy
    return handle
end
registerComponent("TextArea", Components.TextArea)

