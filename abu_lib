--  PERSISTENCE
--==============================================================================

Persist = {}
Persist.enabled = false
Persist.namespace = "limui"

function Persist.setup(namespace, auto)
    Persist.namespace = namespace or "limui"
    Persist.enabled = auto ~= false and Capabilities.writefile and Capabilities.readfile and Capabilities.HttpService
    return Persist.enabled
end

function Persist.path(key)
    return Persist.namespace .. "/" .. key .. ".json"
end

function Persist.read(key)
    if not Persist.enabled or not Capabilities.readfile or not Capabilities.HttpService then return nil end
    local p = Persist.path(key)
    if Capabilities.isfile then
        local ok, exists = pcall(function() return isfile(p) end)
        if not ok or not exists then return nil end
    end
    local ok, data = pcall(readfile, p)
    if not ok then return nil end
    local ok2, decoded = pcall(function() return HttpService:JSONDecode(data) end)
    if not ok2 then return nil end
    return decoded
end

function Persist.write(key, data)
    if not Persist.enabled or not Capabilities.writefile or not Capabilities.HttpService then return false end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then return false end
    local p = Persist.path(key)
    if Capabilities.makefolder then pcall(makefolder, Persist.namespace) end
    local ok2 = pcall(writefile, p, encoded)
    return ok2
end

function Persist.delete(key)
    if not Persist.enabled or not Capabilities.delfile then return false end
    return pcall(delfile, Persist.path(key))
end

