    themePart(btn, "surface")
    themePart(fill, "accent")
    themePart(tLbl, "text")
    Motion.hover(btn, Theme.Current.palette.hover, Theme.Current.palette.surface)

    local pressed = false
    btn.Activated:Connect(function()
        if pressed then return end
        pressed = true
        Utils.call(callback)
