Search = {}
Search.gui = nil
Search.index = {}
Search.byId = {}
Search.hotkeyConn = nil

function Search.init(container)
    local sg = Utils.make("ScreenGui", {
        Name = "LimUI_Search",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, container)
    Host.protect(sg)
    Search.gui = sg
    return sg
end

-- Upsert an item into the index (replaces an existing entry with the same id)
function Search.register(item)
    if type(item) ~= "table" or not item.id then return nil end
    local keywords = item.keywords
    if type(keywords) == "table" then
        keywords = table.concat(keywords, " ")
    elseif keywords == nil then
        keywords = ""
    end
    local entry = {
        id = item.id,
        title = tostring(item.title or item.id),
        desc = tostring(item.desc or item.description or ""),
        keywords = tostring(keywords),
        aliases = item.aliases or "",
        tabId = item.tabId,
        sectionId = item.sectionId,
        controlId = item.controlId,
        type = item.type or "command",
        action = item.action,
        run = item.run,
        hidden = item.hidden or false,
    }
    if Search.byId[entry.id] then
        local idx = Search.byId[entry.id]
        Search.index[idx] = entry
    else
        table.insert(Search.index, entry)
        Search.byId[entry.id] = #Search.index
    end
    return entry.id
end

function Search.unregister(id)
    local idx = Search.byId[id]
    if not idx then return false end
    table.remove(Search.index, idx)
    Search.byId[id] = nil
    -- reindex
    for i, it in ipairs(Search.index) do Search.byId[it.id] = i end
    return true
end

function Search.clear()
    Search.index = {}
    Search.byId = {}
end

-- Index every tab/section/control of a window
function Search.indexWindow(window)
    for _, tab in pairs(window.tabs) do
        Search.register({
            id = "tab:" .. tab.id,
            title = tab.title,
            desc = tab.desc or "Aba",
            keywords = table.concat({ tab.title, tab.desc or "", tab.id }, " "),
            aliases = tab.id,
            tabId = tab.id,
            type = "tab",
        })
        for _, sec in pairs(tab.sections) do
            Search.register({
                id = "section:" .. sec.id,
                title = sec.title,
                desc = sec.desc or "Seção",
                keywords = table.concat({ sec.title, sec.desc or "" }, " "),
                tabId = tab.id,
                sectionId = sec.id,
                type = "section",
            })
        end
    end
end

-- Scoring: exact > prefix > word-start > substring
local function scoreEntry(entry, query)
    if query == "" then return 1 end
    local title = Utils.normalizeText(entry.title)
    local hay = Utils.normalizeText(entry.title .. " " .. entry.desc .. " " ..
        entry.keywords .. " " .. tostring(entry.aliases or ""))
    if title == query then return 100 end
    if string.sub(title, 1, #query) == query then return 80 end
    for word in string.gmatch(hay, "%S+") do
        if string.sub(word, 1, #query) == query then return 50 end
    end
    if string.find(hay, query, 1, true) then return 20 end
    return 0
end

function Search.query(text, limit)
    local norm = Utils.normalizeText(text or "")
    local scored = {}
    for _, entry in ipairs(Search.index) do
        if not entry.hidden then
            local s = scoreEntry(entry, norm)
            if s > 0 then table.insert(scored, { entry = entry, score = s }) end
        end
    end
    table.sort(scored, function(a, b)
        if a.score ~= b.score then return a.score > b.score end
        return a.entry.title < b.entry.title
    end)
    local out = {}
    for i, item in ipairs(scored) do
        if i > (limit or 50) then break end
        table.insert(out, item.entry)
    end
    return out
end

-- Global hotkey: Ctrl+K opens the palette (skipped while typing in a TextBox)
function Search.installHotkey(window)
    if Search.hotkeyConn or not UserInputService then return end
    Search.hotkeyConn = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        local isCtrlK = (input.KeyCode == Enum.KeyCode.K) and
            (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl))
        if not isCtrlK then return end
        -- never hijack while the user is typing
        local focused = UserInputService:GetFocusedTextBox()
        if focused then return end
        Search.openPalette(window)
    end)
end

function Search.openPalette(window)
    if not Search.gui then Search.init(Host.getContainer()) end
