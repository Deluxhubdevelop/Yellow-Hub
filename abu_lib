-- Dropdown
function Components.Dropdown(parent, opts, onChanged)
    opts = opts or {}
    local id = opts.Id or Utils.id("dropdown")
    local title = opts.Title or opts.Name or "Selecionar"
    local desc = opts.Description or ""
    local options = opts.Options or {}
    local default = opts.Default
    local callback = opts.Callback or onChanged or function() end

    local selected = default or (options[1] and (options[1].Id or options[1]) or nil)
    local open = false

    local btn = Utils.make("TextButton", {
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = Theme.Current.palette.surface,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 18,
    }, parent)
    Utils.corner(btn, Theme.Current.shape.radiusButton)
    Utils.stroke(btn, Theme.Current.palette.border, 0.3, 1)

    local tLbl = makeLabel(btn, title, UDim2.new(0.5, 0, 0, 18), nil, nil, nil)
    tLbl.Position = UDim2.fromOffset(14, 8)
    local vLbl = makeLabel(btn, tostring(selected or ""), UDim2.new(0.5, 0, 0, 18), Theme.Current.palette.textMuted, nil, Enum.TextXAlignment.Right)
    vLbl.Position = UDim2.fromOffset(14, 8)
    vLbl.AnchorPoint = Vector2.new(1, 0)

    local arrow = makeLabel(btn, "▼", UDim2.fromOffset(16, 16), Theme.Current.palette.textMuted, nil, nil)
    arrow.Position = UDim2.new(1, -20, 0.5, 0)
    arrow.AnchorPoint = Vector2.new(1, 0.5)

    local list = Utils.make("ScrollingFrame", {
        Position = UDim2.fromOffset(0, 44),
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Theme.Current.palette.panel,
        BorderSizePixel = 0,
        Visible = false,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Theme.Current.palette.accent,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        ZIndex = 60,
    }, parent)
    Utils.corner(list, Theme.Current.shape.radiusCard)
    Utils.stroke(list, Theme.Current.palette.border, 0.3, 1)
    Utils.list(list, 4)
    Utils.pad(list, 6, 6, 6, 6)
    list.Parent = btn.Parent

    local function buildList()
        for _, c in ipairs(list:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for i, opt in ipairs(options) do
            local oid = opt.Id or opt or tostring(i)
            local olabel = opt.Label or opt or tostring(i)
            local ob = Utils.make("TextButton", {
                Size = UDim2.new(1, -12, 0, 30),
                BackgroundColor3 = (selected == oid) and Theme.Current.palette.accent or Theme.Current.palette.surface,
                Text = olabel,
                TextColor3 = (selected == oid) and Color3.fromRGB(255,255,255) or Theme.Current.palette.text,
                Font = Theme.Current.typography.font,
                TextSize = 12,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                ZIndex = 61,
            }, list)
            Utils.corner(ob, 6)
            ob.Activated:Connect(function()
                selected = oid
                Utils.set(vLbl, "Text", tostring(olabel))
                Utils.set(list, "Visible", false)
                Utils.set(btn, "Size", UDim2.new(1, 0, 0, 42))
                Utils.set(arrow, "Text", "▼")
                open = false
                Utils.call(callback, oid)
                buildList()
            end)
        end
    end
    buildList()

    btn.Activated:Connect(function()
        open = not open
        Utils.set(list, "Visible", open)
        if open then
            Utils.set(btn, "Size", UDim2.new(1, 0, 0, 42))
            Utils.set(arrow, "Text", "▲")
            local h = math.min(#options * 34 + 12, 200)
            Utils.set(list, "Size", UDim2.new(1, 0, 0, h))
        else
            Utils.set(arrow, "Text", "▼")
        end
    end)

    themePart(btn, "surface")
    themePart(tLbl, "text")
    themePart(vLbl, "muted")
    themePart(arrow, "muted")
    themePart(list, "panel")
    local handle = Control.new(id, "dropdown", btn, function() return selected end, function(v)
        selected = v
        Utils.call(callback, v)
        buildList()
    end, opts)
    handle.setValue = function(v, silent)
        selected = v
        if not silent then Utils.call(callback, v) end
        buildList()
        return handle
    end
    handle.getValue = function() return selected end
    handle.setOptions = function(newOpts)
        options = newOpts or {}
        buildList()
        return handle
    end
    handle.setDisabled = function(d) Control.setDisabled(handle, d) end
    handle.setVisible = function(v) Control.setVisible(handle, v) end
    handle.destroy = function()
        pcall(function() list:Destroy() end)
        Control.destroy(handle)
    end
    handle.Destroy = handle.destroy
    return handle
end
registerComponent("Dropdown", Components.Dropdown)

