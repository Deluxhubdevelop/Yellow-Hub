--==============================================================================
--  THEME PROPAGATION REGISTRY
--  Components register theme-aware parts here so a theme swap repaints
--  every existing element without rebuilding the UI.
--==============================================================================

Theme.parts = {}

local function themePart(instance, role, extra)
    if not instance then return end
    Theme.parts[instance] = { role = role, extra = extra or {} }
end

local function clearThemeParts(instance)
    Theme.parts[instance] = nil
end

-- role resolver: returns the color a themed part should use for the role
local function roleColor(role, extra)
    local t = Theme.Current
    local p = t.palette
    if role == "window" then return p.background end
    if role == "panel" then return p.panel end
    if role == "surface" then return p.surface end
    if role == "accent" then return p.accent end
    if role == "border" then return p.border end
    if role == "text" then return p.text end
    if role == "muted" then return p.textMuted end
    if role == "icon" then return p.icon end
    if role == "hover" then return p.hover end
    if role == "active" then return p.active end
    if role == "placeholder" then return p.placeholder end
    if role == "success" then return p.success end
    if role == "warning" then return p.warning end
    if role == "error" then return p.error end
    if role == "track" then return p.border end
    if role == "knob" then return Color3.fromRGB(255,255,255) end
    return p.surface
end

function Theme.repaint()
    local t = Theme.Current
    for instance, part in pairs(Theme.parts) do
        if instance and instance.Parent then
            local c = roleColor(part.role, part.extra)
            if part.role == "text" or part.role == "muted" or part.role == "icon" then
                Utils.set(instance, "TextColor3", c)
            elseif part.role == "placeholder" then
                Utils.set(instance, "PlaceholderColor3", c)
            else
                Utils.set(instance, "BackgroundColor3", c)
            end
            if part.extra.stroke then
                local stroke = instance:FindFirstChildOfClass("UIStroke")
                if stroke then Utils.set(stroke, "Color", roleColor(part.extra.stroke, part.extra)) end
            end
        else
            Theme.parts[instance] = nil
        end
    end
    -- Corner radii
    for instance, part in pairs(Theme.parts) do
        local radius = part.extra.radius
        if radius then
            local corner = instance:FindFirstChildOfClass("UICorner")
            if corner then Utils.set(corner, "CornerRadius", UDim.new(0, radius)) end
        end
    end
end

-- Propagate theme changes to all registered windows and controls
function Theme.propagate()
    Theme.repaint()
    for _, w in pairs(WindowMgr.windows) do
        if w.refreshTheme then w:refreshTheme() end
    end
    -- Re-apply state-dependent colors (toggle track, checkbox box, etc.)
    for _, c in pairs(Control.controls) do
        if c.themeHook then Utils.call(c.themeHook) end
    end
end

--==============================================================================
--  MOTION ENGINE
--==============================================================================

Motion = {}
Motion.active = {}

local motionDurations = {
    Instant    = 0.09,
    Micro      = 0.14,
    Standard   = 0.20,
    Navigation = 0.28,
    Emphasis   = 0.36,
    Showcase   = 0.50,
}

local easingPresets = {
    Elegant    = { Enum.EasingStyle.Quart,   Enum.EasingDirection.Out },
    Dynamic    = { Enum.EasingStyle.Back,    Enum.EasingDirection.Out },
    Instant    = { Enum.EasingStyle.Linear,  Enum.EasingDirection.Out },
    SoftSpring = { Enum.EasingStyle.Back,    Enum.EasingDirection.Out },
    Reduced    = { Enum.EasingStyle.Linear,  Enum.EasingDirection.Out },
}

function Motion.duration(className)
    if Theme.Current and Theme.Current.accessibility and Theme.Current.accessibility.reducedMotion then
        return 0.02
    end
    local scale = Theme.Current and Theme.Current.motion.scale or 1
    local base = motionDurations[className] or motionDurations.Standard
    return base * scale
end

function Motion.easing(className)
    local preset = Theme.Current and Theme.Current.motion.preset or "Elegant"
    local e = easingPresets[preset] or easingPresets.Elegant
    return TweenInfo.new(Motion.duration(className or "Standard"), e[1], e[2])
end

function Motion.cancel(instance)
    if not instance then return end
    local ent = Motion.active[instance]
    if ent then
        if ent.tween then pcall(function() ent.tween:Cancel() end) end
        if ent.conn then pcall(function() ent.conn:Disconnect() end) end
        Motion.active[instance] = nil
    end
end

function Motion.cancelAll()
    for inst, _ in pairs(Motion.active) do Motion.cancel(inst) end
end

function Motion.animate(instance, props, dur, style, dir, cb)
    if not instance or not TweenService then return nil end
    Motion.cancel(instance)
    local info = TweenInfo.new(
        dur or Motion.duration("Standard"),
        style or Enum.EasingStyle.Quart,
        dir or Enum.EasingDirection.Out
    )
    local tween = TweenService:Create(instance, info, props)
    local conn
    conn = tween.Completed:Connect(function()
        if Motion.active[instance] and Motion.active[instance].conn == conn then
            Motion.active[instance] = nil
        end
        if cb then Utils.call(cb) end
    end)
    Motion.active[instance] = { tween = tween, conn = conn }
    tween:Play()
    return tween
end

function Motion.hover(instance, targetColor, baseColor)
    if Theme.Current and Theme.Current.accessibility and Theme.Current.accessibility.reducedMotion then return end
    instance.MouseEnter:Connect(function()
        if not instance or not instance.Parent then return end
        Motion.animate(instance, { BackgroundColor3 = targetColor }, Motion.duration("Micro"))
    end)
    instance.MouseLeave:Connect(function()
        if not instance or not instance.Parent then return end
        Motion.animate(instance, { BackgroundColor3 = baseColor }, Motion.duration("Micro"))
    end)
end

