    Utils.stroke(input, Theme.Current.palette.border, 0.3, 1)
    Utils.pad(input, 0, 12, 0, 12)

    local results = Utils.make("ScrollingFrame", {
        Position = UDim2.fromOffset(16, 60),
        Size = UDim2.new(1, -32, 1, -76),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Theme.Current.palette.accent,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        ZIndex = 301,
    }, palette)
    Utils.list(results, 6)

    local emptyLbl = Utils.make("TextLabel", {
        Position = UDim2.fromOffset(8, 8),
        Size = UDim2.new(1, -16, 0, 60),
        BackgroundTransparency = 1,
        Text = "Digite para buscar abas, controles e comandos.",
        TextColor3 = Theme.Current.palette.textMuted,
        Font = Theme.Current.typography.font,
        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Center,
        ZIndex = 302,
    }, results)

    local buttons = {}
    local selectedIndex = 0

    local function clearResults()
        for _, c in ipairs(results:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        buttons = {}
        selectedIndex = 0
    end

    local function highlight(index)
        for i, b in ipairs(buttons) do
            Utils.set(b, "BackgroundColor3", i == index and Theme.Current.palette.accent or Theme.Current.palette.surface)
            local lbl = b:FindFirstChild("ResultTitle")
            if lbl then
                Utils.set(lbl, "TextColor3", i == index and Color3.fromRGB(255,255,255) or Theme.Current.palette.text)
            end
        end
        selectedIndex = index
    end

    local function activate(index)
        local b = buttons[index]
        if not b then return end
        local entry = b:GetAttribute("Entry")
        if entry then
            if entry.tabId and window then window:GoTo(entry.tabId) end
            local action = entry.action or entry.run
            if action then Utils.call(action) end
        end
        pcall(function() palette:Destroy() end)
        if conn then conn:Disconnect() end
    end

    local function build(query)
        clearResults()
        local entries = Search.query(query, 40)
        if #entries == 0 then
            emptyLbl.Visible = true
            emptyLbl.Text = query ~= "" and "Nenhum resultado para \"" .. query .. "\"." or "Digite para buscar abas, controles e comandos."
            return
        end
        emptyLbl.Visible = false
        for i, entry in ipairs(entries) do
            local b = Utils.make("TextButton", {
                Size = UDim2.new(1, -8, 0, 40),
                BackgroundColor3 = Theme.Current.palette.surface,
                Text = "",
                AutoButtonColor = false,
                BorderSizePixel = 0,
                ZIndex = 302,
            }, results)
            Utils.corner(b, 8)
            Utils.stroke(b, Theme.Current.palette.border, 0.2, 1)
            b:SetAttribute("Entry", entry)

            local typeIcon = entry.type == "tab" and "layout" or (entry.type == "section" and "folder" or "play")
            Icons.draw(b, typeIcon, 16, Theme.Current.palette.accent).Position = UDim2.fromOffset(10, 12)

            local lbl = Utils.make("TextLabel", {
                Name = "ResultTitle",
                Position = UDim2.fromOffset(34, 4),
                Size = UDim2.new(1, -44, 0, 18),
                BackgroundTransparency = 1,
                Text = entry.title,
                TextColor3 = Theme.Current.palette.text,
                Font = Theme.Current.typography.bold,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 303,
            }, b)
            local sub = Utils.make("TextLabel", {
                Position = UDim2.fromOffset(34, 22),
                Size = UDim2.new(1, -44, 0, 14),
                BackgroundTransparency = 1,
                Text = entry.desc,
                TextColor3 = Theme.Current.palette.textMuted,
                Font = Theme.Current.typography.font,
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 303,
            }, b)
            b.Activated:Connect(function() activate(i) end)
            buttons[i] = b
        end
        if #buttons > 0 then highlight(1) end
    end
    build("")

    local debounceConn
    input:GetPropertyChangedSignal("Text"):Connect(function()
        if debounceConn then debounceConn:Disconnect() end
        debounceConn = task.delay(0.08, function()
            build(input.Text)
        end)
    end)

    task.defer(function()
        if palette.Parent then input:CaptureFocus() end
    end)

    -- Keyboard: arrows, enter, escape
    local conn
    if UserInputService then
        conn = UserInputService.InputBegan:Connect(function(inputObj, processed)
            if not palette.Parent then
                if conn then conn:Disconnect() end
                return
            end
            if inputObj.KeyCode == Enum.KeyCode.Escape then
                pcall(function() palette:Destroy() end)
                if conn then conn:Disconnect() end
            elseif inputObj.KeyCode == Enum.KeyCode.Down then
                highlight(math.min(selectedIndex + 1, #buttons))
            elseif inputObj.KeyCode == Enum.KeyCode.Up then
                highlight(math.max(selectedIndex - 1, 1))
            elseif inputObj.KeyCode == Enum.KeyCode.Return then
                activate(selectedIndex)
            end
        end)
    end
end

