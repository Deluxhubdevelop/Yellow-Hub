-- Slider
function Components.Slider(parent, opts, onChanged)
    opts = opts or {}
    local id = opts.Id or Utils.id("slider")
    local title = opts.Title or opts.Name or "Slider"
    local desc = opts.Description or ""
    local min = opts.Min or 0
    local max = opts.Max or 100
    local step = opts.Step or 1
    local default = opts.Default or min
    local suffix = opts.Suffix or ""
    local callback = opts.Callback or onChanged or function() end

    local val = math.clamp(default, min, max)

    local btn = Utils.make("TextButton", {
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = Theme.Current.palette.surface,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 18,
    }, parent)
    Utils.corner(btn, Theme.Current.shape.radiusButton)
    Utils.stroke(btn, Theme.Current.palette.border, 0.3, 1)

    local tLbl = makeLabel(btn, title, UDim2.new(0.5, 0, 0, 18), nil, nil, nil)
    tLbl.Position = UDim2.fromOffset(14, 8)
    local vLbl = makeLabel(btn, tostring(val) .. suffix, UDim2.new(0.5, 0, 0, 18), Theme.Current.palette.accent, Theme.Current.typography.bold, Enum.TextXAlignment.Right)
    vLbl.Position = UDim2.fromOffset(14, 8)
    vLbl.AnchorPoint = Vector2.new(1, 0)

    local track = Utils.make("Frame", {
        Position = UDim2.fromOffset(14, 34),
        Size = UDim2.new(1, -28, 0, 6),
        BackgroundColor3 = Theme.Current.palette.border,
        BorderSizePixel = 0,
        ZIndex = 18,
    }, btn)
    Utils.corner(track, 3)

    local fill = Utils.make("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Theme.Current.palette.accent,
        BorderSizePixel = 0,
        ZIndex = 19,
    }, track)
    Utils.corner(fill, 3)

    local knob = Utils.make("Frame", {
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BorderSizePixel = 0,
        ZIndex = 20,
    }, fill)
    Utils.corner(knob, 8)
    Utils.stroke(knob, Theme.Current.palette.accent, 0, 1.5)

    local dragging = false
    local function update(percent)
        percent = math.clamp(percent, 0, 1)
        local raw = min + (max - min) * percent
        if step and step > 0 then raw = math.floor((raw - min) / step + 0.5) * step + min end
        val = math.clamp(raw, min, max)
        local pct = (val - min) / (max - min)
        Utils.set(fill, "Size", UDim2.new(pct, 0, 1, 0))
        Utils.set(knob, "Position", UDim2.new(pct, -8, 0.5, 0))
        Utils.set(vLbl, "Text", tostring(val) .. suffix)
        Utils.call(callback, val)
    end

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local abs = track.AbsolutePosition.X
            local w = track.AbsoluteSize.X
            local pct = (input.Position.X - abs) / w
            update(pct)
        end
    end)
    local dragConn
    if UserInputService then
        dragConn = UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
            local abs = track.AbsolutePosition.X
            local w = track.AbsoluteSize.X
            local pct = (input.Position.X - abs) / w
            update(pct)
        end)
    end
    local endConn
    if UserInputService then
        endConn = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)
    end

    themePart(btn, "surface")
    themePart(track, "track")
    themePart(fill, "accent")
    themePart(tLbl, "text")
    themePart(vLbl, "accent")
    update((val - min) / (max - min))

    local handle = Control.new(id, "slider", btn, function() return val end, function(v)
        val = math.clamp(v, min, max)
        update((val - min) / (max - min))
    end, opts)
    handle.setValue = function(v, silent)
        val = math.clamp(v, min, max)
        local pct = (val - min) / (max - min)
        Utils.set(fill, "Size", UDim2.new(pct,0,1,0))
        Utils.set(knob, "Position", UDim2.new(pct,-8,0.5,0))
        Utils.set(vLbl, "Text", tostring(val)..suffix)
        if not silent then Utils.call(callback, val) end
        return handle
    end
    handle.getValue = function() return val end
    handle.setDisabled = function(d) Control.setDisabled(handle, d); dragging = false end
    handle.setVisible = function(v) Control.setVisible(handle, v) end
    handle.destroy = function()
        if dragConn then dragConn:Disconnect() end
        if endConn then endConn:Disconnect() end
        Control.destroy(handle)
    end
    handle.Destroy = handle.destroy
    return handle
end
