function Icons.get(kind, size, color)
    size = size or 20
    color = color or Color3.fromRGB(170,185,200)
    if type(kind) == "string" and (kind:find("rbxassetid://") or kind:find("^%d+$")) then
        return { kind = "image", asset = kind }
    end
    local glyph = glyphs[kind] or kind or "?"
    return { kind = "glyph", glyph = glyph, size = size, color = color }
end

function Icons.draw(parent, kind, size, color)
    local spec = Icons.get(kind, size, color)
    local holder = Utils.make("Frame", {
        Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, parent)
    if spec.kind == "image" then
        Utils.make("ImageLabel", {
            Size = UDim2.fromScale(1,1),
            BackgroundTransparency = 1,
            Image = spec.asset,
            ScaleType = Enum.ScaleType.Fit,
        }, holder)
    else
        Utils.make("TextLabel", {
            Size = UDim2.fromScale(1,1),
            BackgroundTransparency = 1,
            Text = spec.glyph,
            TextColor3 = spec.color,
            Font = Enum.Font.GothamBold,
            TextSize = spec.size * 0.85,
        }, holder)
    end
    return holder
end

