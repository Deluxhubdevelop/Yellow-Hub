function Host.getContainer()
    if Capabilities.gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end
    if LocalPlayer then
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if pg then return pg end
