    local track = Utils.make("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.fromOffset(14, 21),
        Size = UDim2.fromOffset(46, 22),
        BackgroundColor3 = val and Theme.Current.palette.accent or Theme.Current.palette.border,
        BorderSizePixel = 0,
