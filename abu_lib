--==============================================================================
--  WINDOW SHORTCUTS
--==============================================================================

function Window:Tab(opts)
    if type(opts) == "string" then opts = { Title = opts } end
    return Tab.new(self, opts)
end

function Window:Section(opts)
    if type(opts) == "string" then opts = { Title = opts } end
    local tab = self.tabs[self.tabOrder[1]]
    if not tab then tab = self:Tab({ Title = "Principal" }) end
    return Section.new(tab, opts)
end

function Window:_comp(kind, ...)
    local args = {...}
    local tab = self.tabs[self.tabOrder[1]]
    if not tab then tab = self:Tab({ Title = "Principal" }) end
    local section = tab.sections[next(tab.sections)] or Section.new(tab, { Title = "Controles" })
    local body = section.container
    local first = args[1]
    local opts, cb
    if type(first) == "string" then
        opts = { Title = first }
        cb = args[2]
    else
        opts = first
        cb = args[2]
    end
    if type(opts) == "table" then
        opts.__tabId = tab.id
        opts.__sectionId = section.id
    end
    local comp = Components.resolve(kind)
    if not comp then
        warn("[limui] component type not found: " .. tostring(kind))
        return nil
    end
    return comp(body, opts, cb)
end

for _, k in ipairs({"Button","Toggle","Slider","Dropdown","Input","ColorPicker","Keybind","Checkbox","Label","Separator","Paragraph","Card"}) do
    Window[k] = function(self, ...) return self:_comp(k, ...) end
end

