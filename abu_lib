        local dLbl = makeLabel(btn, desc, UDim2.new(1, -90, 0, 14), Theme.Current.palette.textMuted, nil, nil)
        dLbl.Position = UDim2.fromOffset(70, 23)
        dLbl.TextSize = 11
    end

    local function set(v)
        val = v
        Utils.set(track, "BackgroundColor3", v and Theme.Current.palette.accent or Theme.Current.palette.border)
        Motion.animate(knob, { Position = v and UDim2.fromOffset(26,2) or UDim2.fromOffset(2,2) }, Motion.duration("Micro"))
        Utils.call(callback, v)
    end

    themePart(btn, "surface")
    themePart(tLbl, "text")
    btn.Activated:Connect(function() set(not val) end)
    set(val)

    local handle = Control.new(id, "toggle", btn, function() return val end, function(v) set(v) end, opts)
    handle.themeHook = function()
        Utils.set(track, "BackgroundColor3", val and Theme.Current.palette.accent or Theme.Current.palette.border)
    end
    handle.setValue = function(v, silent)
        if silent then
            val = v
            Utils.set(track, "BackgroundColor3", v and Theme.Current.palette.accent or Theme.Current.palette.border)
            Utils.set(knob, "Position", v and UDim2.fromOffset(26,2) or UDim2.fromOffset(2,2))
        else
            set(v)
        end
        return handle
    end
    handle.getValue = function() return val end
    handle.setDisabled = function(d) Control.setDisabled(handle, d) end
    handle.setVisible = function(v) Control.setVisible(handle, v) end
    handle.destroy = function() Control.destroy(handle) end
    handle.Destroy = handle.destroy
    return handle
end
