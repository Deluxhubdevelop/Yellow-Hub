-- Keybind
function Components.Keybind(parent, opts, onChanged)
    opts = opts or {}
    local id = opts.Id or Utils.id("keybind")
    local title = opts.Title or opts.Name or "Tecla"
    local default = opts.Default or Enum.KeyCode.Unknown
    local callback = opts.Callback or onChanged or function() end

    local key = default
    local listening = false

    local btn = Utils.make("TextButton", {
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = Theme.Current.palette.surface,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 18,
    }, parent)
    Utils.corner(btn, Theme.Current.shape.radiusButton)
    Utils.stroke(btn, Theme.Current.palette.border, 0.3, 1)

    local tLbl = makeLabel(btn, title, UDim2.new(0.6, 0, 0, 18), nil, nil, nil)
    tLbl.Position = UDim2.fromOffset(14, 8)
    local kLbl = makeLabel(btn, key == Enum.KeyCode.Unknown and "Desatribuída" or key.Name, UDim2.new(0.4, 0, 0, 18), Theme.Current.palette.textMuted, nil, Enum.TextXAlignment.Right)
    kLbl.Position = UDim2.fromOffset(14, 8)
    kLbl.AnchorPoint = Vector2.new(1, 0)

    btn.Activated:Connect(function()
        listening = true
        Utils.set(kLbl, "Text", "Pressione uma tecla...")
        Utils.set(kLbl, "TextColor3", Theme.Current.palette.accent)
    end)

    local conn
    if UserInputService then
        conn = UserInputService.InputBegan:Connect(function(input, processed)
            if not listening then return end
            if processed then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                key = input.KeyCode
                listening = false
                Utils.set(kLbl, "Text", key.Name)
                Utils.set(kLbl, "TextColor3", Theme.Current.palette.textMuted)
                Utils.call(callback, key)
            end
        end)
    end

    themePart(btn, "surface")
    themePart(tLbl, "text")
    themePart(kLbl, "muted")
    local handle = Control.new(id, "keybind", btn, function() return key end, function(v)
        key = v or Enum.KeyCode.Unknown
        Utils.set(kLbl, "Text", key == Enum.KeyCode.Unknown and "Desatribuída" or key.Name)
    end, opts)
    handle.setValue = function(v, silent)
        key = v
        Utils.set(kLbl, "Text", key == Enum.KeyCode.Unknown and "Desatribuída" or key.Name)
        if not silent then Utils.call(callback, key) end
        return handle
    end
    handle.getValue = function() return key end
    handle.setDisabled = function(d) Control.setDisabled(handle, d) end
    handle.setVisible = function(v) Control.setVisible(handle, v) end
    handle.destroy = function()
        if conn then conn:Disconnect() end
        Control.destroy(handle)
    end
    handle.Destroy = handle.destroy
    return handle
end
