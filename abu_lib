function Components.Progress(parent, opts)
    opts = opts or {}
    local id = opts.Id or Utils.id("progress")
    local title = opts.Title or opts.Name or "Progresso"
    local min = opts.Min or 0
    local max = opts.Max or 100
    local value = opts.Default or 0
    local suffix = opts.Suffix or "%"

    local container = Utils.make("Frame", {
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundTransparency = 1,
        ZIndex = 18,
    }, parent)
    Utils.list(container, 6)

    local tLbl = makeLabel(container, title, UDim2.new(1, 0, 0, 16), Theme.Current.palette.text, nil, nil)
    local pLbl = makeLabel(container, tostring(value) .. suffix, UDim2.new(1, 0, 0, 14), Theme.Current.palette.textMuted, nil, Enum.TextXAlignment.Right)

    local track = Utils.make("Frame", {
        Size = UDim2.new(1, 0, 0, 8),
        BackgroundColor3 = Theme.Current.palette.border,
        BorderSizePixel = 0,
        ZIndex = 18,
    }, container)
    Utils.corner(track, 4)

    local fill = Utils.make("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Current.palette.accent,
        BorderSizePixel = 0,
        ZIndex = 19,
    }, track)
    Utils.corner(fill, 4)

    local handle = Control.new(id, "progress", container, function() return value end, function(v)
        value = math.clamp(v, min, max)
        local pct = (value - min) / (max - min)
        Utils.set(fill, "Size", UDim2.new(pct, 0, 1, 0))
        Utils.set(pLbl, "Text", tostring(value) .. suffix)
    end, opts)
    handle.setValue = function(v, silent)
        value = math.clamp(v, min, max)
        local pct = (value - min) / (max - min)
        Utils.set(fill, "Size", UDim2.new(pct, 0, 1, 0))
        Utils.set(pLbl, "Text", tostring(value) .. suffix)
        return handle
    end
    handle.getValue = function() return value end
    handle.destroy = function() Control.destroy(handle) end
    handle.Destroy = handle.destroy
    return handle
end
registerComponent("Progress", Components.Progress)

