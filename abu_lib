Notify = {}
Notify.queue = {}
Notify.gui = nil

function Notify.init(container)
    local ng = Utils.make("ScreenGui", {
        Name = "LimUI_Notifications",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, container)
    Host.protect(ng)
    Notify.gui = ng
    return ng
end

function Notify.create(opts)
    opts = opts or {}
    if not Notify.gui then Notify.init(Host.getContainer()) end
    local t = Theme.Current
    local typeColors = {
        Info    = t.palette.accent,
        Success = t.palette.success,
        Warning = t.palette.warning,
        Error   = t.palette.error,
    }
    local color = typeColors[opts.Type or "Info"] or t.palette.accent

    local toast = Utils.make("Frame", {
        Size = UDim2.new(0, 300, 0, 70),
        BackgroundColor3 = t.palette.panel,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -310, 1, -90),
        ZIndex = 200,
        Visible = false,
    }, Notify.gui)
    Utils.corner(toast, 12)
    Utils.stroke(toast, color, 0, 1.5)

    local bar = Utils.make("Frame", {
        Position = UDim2.fromOffset(0,0),
        Size = UDim2.fromOffset(4, 0),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        ZIndex = 201,
    }, toast)
    Utils.corner(bar, 2)

    local icon = Utils.make("TextLabel", {
        Position = UDim2.fromOffset(12, 10),
        Size = UDim2.fromOffset(24, 24),
        BackgroundTransparency = 1,
        Text = opts.Icon or "󰋼",
        TextColor3 = color,
        Font = Theme.Current.typography.bold,
        TextSize = 16,
        ZIndex = 202,
    }, toast)

    local tLbl = makeLabel(toast, opts.Title or "Notificação", UDim2.new(1, -70, 0, 20), t.palette.text, Theme.Current.typography.bold, nil)
    tLbl.Position = UDim2.fromOffset(44, 10)
    local dLbl = makeLabel(toast, opts.Description or "", UDim2.new(1, -70, 0, 30), t.palette.textMuted, Theme.Current.typography.font, nil)
    dLbl.Position = UDim2.fromOffset(44, 32)
    Utils.set(dLbl, "TextWrapped", true)

    table.insert(Notify.queue, toast)
    Notify.layout()

    toast.Visible = true
    toast.BackgroundTransparency = 1
    Motion.animate(toast, { BackgroundTransparency = 0, Position = UDim2.new(1, -310, 1, -90 - (#Notify.queue - 1)*80) }, Motion.duration("Micro"))

    local duration = opts.Duration or 4
    task.delay(duration, function()
        Notify.dismiss(toast)
    end)
    return toast
end

function Notify.dismiss(toast)
    for i, t in ipairs(Notify.queue) do
        if t == toast then
            table.remove(Notify.queue, i)
            break
        end
    end
    Motion.animate(toast, { BackgroundTransparency = 1 }, Motion.duration("Micro"), function()
        pcall(function() toast:Destroy() end)
    end)
    Notify.layout()
end

function Notify.layout()
    for i, t in ipairs(Notify.queue) do
        Motion.animate(t, { Position = UDim2.new(1, -310, 1, -90 - (i-1)*80) }, Motion.duration("Micro"))
    end
end

