    dockIcon.Activated:Connect(function() self:Restore() end)
    local dockLabel = Utils.make("TextLabel", {
        Position = UDim2.new(0, 0, 0, 50),
        Size = UDim2.new(1, 0, 0, 150),
        BackgroundTransparency = 1,
        Text = self.title,
        TextColor3 = t.palette.textMuted,
        Font = t.typography.font,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Center,
        ZIndex = 51,
    }, self.minDock)

    -- Floating button supports an optional custom asset id
    local minAsset = self.opts.Minimize and self.opts.Minimize.iconAsset
    if not minAsset and self.opts.Minimize then minAsset = self.opts.Minimize.DefaultIcon end
    if minAsset and minAsset ~= "" then
        local img = self.minGui:FindFirstChildOfClass("TextLabel")
        if img then img:Destroy() end
        Utils.make("ImageLabel", {
            Position = UDim2.fromOffset(6, 6),
            Size = UDim2.fromOffset(44, 44),
            BackgroundTransparency = 1,
            Image = minAsset,
            ScaleType = Enum.ScaleType.Fit,
            ZIndex = 51,
        }, self.minGui)
    end
end

function Window:Resize(width, height)
    if self.destroyed then return end
    width = math.clamp(width or 780, 320, 1600)
    height = math.clamp(height or 520, 240, 1000)
    self._size = { width = width, height = height }
    Motion.animate(self.main, { Size = UDim2.fromOffset(width, height) }, Motion.duration("Standard"))
    Motion.animate(self.shadow, { Size = UDim2.fromOffset(width + 8, height + 8) }, Motion.duration("Standard"))
end

function Window:_minimizeMode()
    local mode = (self.opts.Minimize and self.opts.Minimize.mode) or "CompactBar"
    if mode == "Auto" then
        -- Auto picks by viewport + input, never by device name
        local cam = Workspace and Workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
        if vp.X < 900 or IsMobile then mode = "CompactBar" else mode = "FloatingButton" end
    end
    return mode
end

function Window:setMinimizeMode(mode)
    self.opts.Minimize = self.opts.Minimize or {}
    self.opts.Minimize.mode = mode
    self:_buildMinimizePresentations()
    if self.minimized then
        self:_showMinimizePresentation()
    end
end

function Window:_hideMinimizePresentations()
    if self.minGui then self.minGui.Visible = false end
    if self.minBar then self.minBar.Visible = false end
    if self.minDock then self.minDock.Visible = false end
end

function Window:_showMinimizePresentation()
    self:_buildMinimizePresentations()
    local mode = self:_minimizeMode()
    self:_hideMinimizePresentations()
    if mode == "CompactBar" then
        self.minBar.Visible = true
        Motion.animate(self.minBar, { Position = UDim2.fromOffset(20, 20) }, Motion.duration("Emphasis"))
    elseif mode == "Dock" then
        self.minDock.Visible = true
        Motion.animate(self.minDock, { Position = UDim2.fromOffset(12, 0.5) }, Motion.duration("Emphasis"))
    else -- FloatingButton
        self.minGui.Visible = true
        Motion.animate(self.minGui, { Position = self.minGui.Position }, Motion.duration("Emphasis"))
    end
end

function Window:Minimize()
    if self.destroyed or self.minimized then return end
    self.minimized = true
    self._size = { width = self.main.Size.X.Offset, height = self.main.Size.Y.Offset }
    Motion.animate(self.main, {
        Size = UDim2.fromOffset(0, 0),
        BackgroundTransparency = 1,
    }, Motion.duration("Emphasis"))
    Motion.animate(self.shadow, { BackgroundTransparency = 1 }, Motion.duration("Emphasis"))
    task.delay(Motion.duration("Emphasis"), function()
        if self.destroyed or not self.minimized then return end
        self.main.Visible = false
        self.shadow.Visible = false
        self:_showMinimizePresentation()
    end)
    WindowMgr.focus(self)
end

function Window:Restore()
    if self.destroyed or not self.minimized then return end
    self.minimized = false
    self:_hideMinimizePresentations()
    self.main.Visible = true
    self.shadow.Visible = true
    local size = self._size or { width = 780, height = 520 }
    Motion.animate(self.main, {
        Size = UDim2.fromOffset(size.width, size.height),
        BackgroundTransparency = Theme.Current.glass.opacity,
    }, Motion.duration("Emphasis"))
    Motion.animate(self.shadow, {
        Size = UDim2.fromOffset(size.width + 8, size.height + 8),
        BackgroundTransparency = 0.5,
    }, Motion.duration("Emphasis"))
    WindowMgr.focus(self)
end

