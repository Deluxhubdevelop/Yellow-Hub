    }, panel)
    Utils.list(list, 6)

    local function refresh()
        for _, c in ipairs(list:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        for _, def in ipairs(WidgetEngine.catalog()) do
            local added = false
            for _, w in pairs(WidgetEngine.instances) do
                if w.def.Id == def.Id then added = true break end
            end
            local row = Utils.make("TextButton", {
                Size = UDim2.new(1, -8, 0, 44),
                BackgroundColor3 = t.palette.surface,
                Text = "",
                AutoButtonColor = false,
                BorderSizePixel = 0,
                ZIndex = 602,
            }, list)
            Utils.corner(row, 10)
            Utils.stroke(row, t.palette.border, 0.2, 1)
            Icons.draw(row, def.Icon or "layout", 18, t.palette.accent).Position = UDim2.fromOffset(10, 13)
            Utils.make("TextLabel", {
                Position = UDim2.fromOffset(38, 5),
                Size = UDim2.new(1, -120, 0, 18),
                BackgroundTransparency = 1,
                Text = def.Title,
                TextColor3 = t.palette.text,
                Font = t.typography.bold,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 603,
            }, row)
            Utils.make("TextLabel", {
                Position = UDim2.fromOffset(38, 23),
                Size = UDim2.new(1, -120, 0, 14),
                BackgroundTransparency = 1,
                Text = def.Description,
                TextColor3 = t.palette.textMuted,
                Font = t.typography.font,
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 603,
            }, row)

            local action = Utils.make("TextButton", {
                Position = UDim2.new(1, -76, 0, 9),
                Size = UDim2.fromOffset(66, 26),
                BackgroundColor3 = added and t.palette.border or t.palette.accent,
                Text = added and "Remover" or "Adicionar",
                TextColor3 = Color3.fromRGB(255,255,255),
                Font = t.typography.font,
                TextSize = 11,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                ZIndex = 603,
            }, row)
            Utils.corner(action, 7)
            action.Activated:Connect(function()
                if added then
                    for id, w in pairs(WidgetEngine.instances) do
                        if w.def.Id == def.Id then WidgetEngine.remove(id) break end
                    end
                else
                    WidgetEngine.add(def.Id, {})
                end
                refresh()
            end)
        end
    end
    refresh()
end

