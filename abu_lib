function Components.MultiSelect(parent, opts, onChanged)
    opts = opts or {}
    local id = opts.Id or Utils.id("multiselect")
    local title = opts.Title or opts.Name or "Múltipla seleção"
    local options = opts.Options or {}
    local defaults = opts.Default or {}
    local max = opts.Max or #options
    local callback = opts.Callback or onChanged or function() end

    local selected = {}
    for _, v in ipairs(defaults) do selected[v] = true end

    local container = Utils.make("Frame", {
        Size = UDim2.new(1, 0, 0, 42 + #options * 26),
        BackgroundTransparency = 1,
        ZIndex = 18,
    }, parent)
    Utils.list(container, 6)

    local tLbl = makeLabel(container, title, UDim2.new(1, 0, 0, 16), Theme.Current.palette.text, nil, nil)

    local handle = {
        id = id,
        setValue = function(v, silent)
            selected = {}
            for _, val in ipairs(v or {}) do selected[val] = true end
            rebuild()
            if not silent then Utils.call(callback, getSelectedIds()) end
            return handle
        end,
        getValue = function() return getSelectedIds() end,
        setDisabled = function(d) Control.setDisabled(handle, d) end,
        setVisible = function(v) Control.setVisible(handle, v) end,
        destroy = function() Control.destroy(handle) end,
        Destroy = function() handle.destroy() end,
    }

    function getSelectedIds()
        local ids = {}
        for k, v in pairs(selected) do if v then table.insert(ids, k) end end
        return ids
    end

    function rebuild()
        for _, c in ipairs(container:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for _, opt in ipairs(options) do
            local oid = opt.Id or opt or tostring(#options)
            local olabel = opt.Label or opt or tostring(oid)
            local btn = Utils.make("TextButton", {
                Size = UDim2.new(1, 0, 0, 24),
                BackgroundColor3 = selected[oid] and Theme.Current.palette.accent or Theme.Current.palette.surface,
                Text = olabel,
                TextColor3 = selected[oid] and Color3.fromRGB(255,255,255) or Theme.Current.palette.text,
                Font = Theme.Current.typography.font,
                TextSize = 12,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                ZIndex = 19,
            }, container)
            Utils.corner(btn, 6)
            Utils.stroke(btn, Theme.Current.palette.border, 0.2, 1)
            btn.Activated:Connect(function()
                selected[oid] = not selected[oid]
                Utils.set(btn, "BackgroundColor3", selected[oid] and Theme.Current.palette.accent or Theme.Current.palette.surface)
                Utils.call(callback, getSelectedIds())
            end)
        end
    end
    rebuild()

    Control.controls[id] = handle
    return handle
end
registerComponent("MultiSelect", Components.MultiSelect)

