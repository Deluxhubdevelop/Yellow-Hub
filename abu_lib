Glass = {}

function Glass.material(name)
    name = name or Theme.Glass
    Theme.Glass = name
    if Theme.Current then Theme.Current.glass.material = name end
    Theme.propagate()
end

local function glassFrameStyle(material)
    local styles = {
        Clear    = { opacity = 0.92, glow = 0.08, reflection = 0.06, border = 0.25 },
        Frosted  = { opacity = 0.85, glow = 0.18, reflection = 0.12, border = 0.35 },
        Deep     = { opacity = 0.78, glow = 0.28, reflection = 0.20, border = 0.45 },
        Prismatic= { opacity = 0.82, glow = 0.35, reflection = 0.15, border = 0.30 },
        Solid    = { opacity = 1.00, glow = 0.00, reflection = 0.00, border = 0.50 },
    }
    return styles[material] or styles.Frosted
end

function Glass.applyWindow(frame, opts)
    opts = opts or {}
    local t = Theme.Current
    local p = t.palette
    local g = t.glass
    local s = t.shape
    local style = glassFrameStyle(g.material)

    Utils.set(frame, "BackgroundColor3", p.background)
    Utils.set(frame, "BackgroundTransparency", opts.transparency or style.opacity)
    Utils.set(frame, "BorderSizePixel", 0)
    Utils.corner(frame, opts.radius or s.radiusWindow)
    Utils.stroke(frame, opts.borderColor or p.border, opts.borderTransparency or style.border, g.borderWidth)

    -- Edge light (inner glow)
    local glow = Utils.make("Frame", {
        Name = "GlassEdge",
        Position = UDim2.fromOffset(1,1),
        Size = UDim2.new(1,-2,1,-2),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BackgroundTransparency = 0.94 - (style.glow * 0.3),
        BorderSizePixel = 0,
        ZIndex = (frame.ZIndex or 10) + 1,
    }, frame)
    Utils.corner(glow, opts.radius or s.radiusWindow)

    -- Specular reflection (top)
    local spec = Utils.make("Frame", {
        Name = "Specular",
        Position = UDim2.fromOffset(0,0),
        Size = UDim2.new(1,0,0,1),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BackgroundTransparency = 0.80 - (style.reflection * 0.3),
        BorderSizePixel = 0,
        ZIndex = (frame.ZIndex or 10) + 2,
    }, frame)

    return { glow = glow, specular = spec }
end

function Glass.applyPanel(frame, opts)
    opts = opts or {}
    local t = Theme.Current
    local p = t.palette
    local g = t.glass
    local style = glassFrameStyle(g.material)
    Utils.set(frame, "BackgroundColor3", opts.color or p.panel)
    Utils.set(frame, "BackgroundTransparency", opts.transparency or style.opacity)
    Utils.set(frame, "BorderSizePixel", 0)
    Utils.corner(frame, opts.radius or t.shape.radiusCard)
    if opts.stroke ~= false then
        Utils.stroke(frame, opts.strokeColor or p.border, opts.strokeTransparency or style.border, 1)
    end
end

function Glass.applyButton(btn, opts)
    opts = opts or {}
    local t = Theme.Current
    local p = t.palette
    Utils.set(btn, "BackgroundColor3", opts.color or p.surface)
    Utils.set(btn, "BackgroundTransparency", opts.transparency or 0)
    Utils.corner(btn, opts.radius or t.shape.radiusButton)
    Utils.stroke(btn, opts.strokeColor or p.border, 0.3, 1)
end

