--==============================================================================
--  INPUT MANAGER
--==============================================================================

Input = {}
Input.drags = {}
Input.hotkeys = {}

local dragConnection = nil
local releaseConnection = nil
local activeDragGui = nil

function Input.beginDrag(gui, handle, onMove, onEnd)
    Input.endDrag()
    activeDragGui = gui
    Input.drags[gui] = {
        active = true,
        startMouse = UserInputService and UserInputService:GetMouseLocation() or Vector2.new(0,0),
        obj = gui,
        onMove = onMove,
        onEnd = onEnd,
    }
    if not dragConnection and UserInputService then
        dragConnection = UserInputService.InputChanged:Connect(function(input, processed)
            if processed or not activeDragGui then return end
            local d = Input.drags[activeDragGui]
            if not d or not d.active then return end
            local mouse = UserInputService:GetMouseLocation()
            local delta = mouse - d.startMouse
            if d.onMove then d.onMove(delta) end
            d.startMouse = mouse
        end)
        releaseConnection = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                Input.endDrag()
            end
        end)
    end
end

function Input.endDrag()
    if activeDragGui then
        local d = Input.drags[activeDragGui]
        if d and d.onEnd then d.onEnd() end
        Input.drags[activeDragGui] = nil
        activeDragGui = nil
    end
    if dragConnection then dragConnection:Disconnect(); dragConnection = nil end
    if releaseConnection then releaseConnection:Disconnect(); releaseConnection = nil end
end

