    local dLbl = makeLabel(modal, desc, UDim2.new(1, -40, 0, 60), Theme.Current.palette.textMuted, Theme.Current.typography.font, nil)
    dLbl.Position = UDim2.fromOffset(20, 44)
    Utils.set(dLbl, "TextWrapped", true)

    local btnContainer = Utils.make("Frame", {
        Position = UDim2.new(1, -10, 1, -10),
        Size = UDim2.new(0, 200, 0, 34),
        BackgroundTransparency = 1,
        ZIndex = 701,
    }, modal)
    Utils.list(btnContainer, 10)
    btnContainer.AnchorPoint = Vector2.new(1, 1)

    local btnCancel = Utils.make("TextButton", {
        Size = UDim2.new(0.5, -5, 0, 34),
        BackgroundColor3 = Theme.Current.palette.surface,
        Text = cancelText,
        TextColor3 = Theme.Current.palette.text,
        Font = Theme.Current.typography.font,
        TextSize = 12,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 702,
    }, btnContainer)
    Utils.corner(btnCancel, 8)
    Utils.stroke(btnCancel, Theme.Current.palette.border, 0.3, 1)

    local btnConfirm = Utils.make("TextButton", {
        Size = UDim2.new(0.5, -5, 0, 34),
        BackgroundColor3 = Theme.Current.palette.accent,
        Text = confirmText,
        TextColor3 = Color3.fromRGB(255,255,255),
        Font = Theme.Current.typography.font,
        TextSize = 12,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 702,
    }, btnContainer)
    Utils.corner(btnConfirm, 8)

    local open = false
    local handle = {
        id = id,
        open = function()
            open = true
            modal.Visible = true
            modal.BackgroundTransparency = 1
            Motion.animate(modal, { BackgroundTransparency = 0 }, Motion.duration("Standard"))
        end,
        close = function()
            open = false
            Motion.animate(modal, { BackgroundTransparency = 1 }, Motion.duration("Standard"), function()
                modal.Visible = false
            end)
        end,
        destroy = function()
            pcall(function() modal:Destroy() end)
            Control.controls[id] = nil
        end,
        Destroy = function() handle.destroy() end,
    }

    btnConfirm.Activated:Connect(function()
        Utils.call(callback, true)
        handle.close()
    end)
    btnCancel.Activated:Connect(function()
        Utils.call(callback, false)
        handle.close()
    end)

    return handle
end
registerComponent("Modal", Components.Modal)

