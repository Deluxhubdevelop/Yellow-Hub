local Utils = {}

function Utils.call(fn, ...)
    if type(fn) ~= "function" then return nil end
    local ok, res = pcall(fn, ...)
    if not ok then warn("[limui] callback error: " .. tostring(res)) end
    return res
end

function Utils.make(className, props, parent)
    local ok, obj = pcall(function()
        local o = Instance.new(className)
        if props then
            for k, v in pairs(props) do
                pcall(function() o[k] = v end)
            end
        end
        if parent then o.Parent = parent end
        return o
    end)
    return ok and obj or nil
end

function Utils.corner(obj, radius)
    if not obj then return end
    return Utils.make("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, obj)
end

function Utils.stroke(obj, color, transparency, thickness)
    if not obj then return end
    return Utils.make("UIStroke", {
        Color = color or Color3.fromRGB(255,255,255),
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, obj)
end

function Utils.gradient(obj, color, rotation)
    if not obj then return end
    return Utils.make("UIGradient", { Color = color, Rotation = rotation or 0 }, obj)
end

function Utils.list(parent, padding, sortOrder)
    return Utils.make("UIListLayout", {
        Padding = UDim.new(0, padding or 6),
        SortOrder = sortOrder or Enum.SortOrder.LayoutOrder,
    }, parent)
end

function Utils.pad(parent, t, l, b, r)
    return Utils.make("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingLeft = UDim.new(0, l or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingRight = UDim.new(0, r or 0),
    }, parent)
end

function Utils.scale(obj, s)
    return Utils.make("UIScale", { Scale = s or 1 }, obj)
end

function Utils.hex(hexStr)
    hexStr = tostring(hexStr):gsub("#", "")
    local r = tonumber(hexStr:sub(1,2), 16) or 255
    local g = tonumber(hexStr:sub(3,4), 16) or 255
    local b = tonumber(hexStr:sub(5,6), 16) or 255
    return Color3.fromRGB(r, g, b)
end

function Utils.colorToHex(c)
    return string.format("#%02X%02X%02X",
        math.floor(c.R * 255 + 0.5),
        math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5))
end

function Utils.lerp(a, b, t) return a + (b - a) * t end

function Utils.clamp(v, lo, hi) return math.min(math.max(v, lo), hi) end

function Utils.deepCopy(t)
    if type(t) ~= "table" then return t end
    local out = {}
    for k, v in pairs(t) do
        if type(v) == "table" then out[k] = Utils.deepCopy(v) else out[k] = v end
    end
    return out
end

function Utils.id(prefix)
    prefix = prefix or "id"
    return prefix .. "-" .. tostring(math.random(100000, 999999)) .. "-" .. tostring(tick()):sub(-5)
end

function Utils.normalizeText(s)
    if type(s) ~= "string" then return "" end
    local lower = string.lower(s)
    local repl = {["á"]="a",["à"]="a",["ã"]="a",["â"]="a",["é"]="e",["ê"]="e",
                  ["í"]="i",["ó"]="o",["ô"]="o",["õ"]="o",["ú"]="u",["ç"]="c"}
    for o, r in pairs(repl) do lower = lower:gsub(o, r) end
    return lower
end

function Utils.set(obj, prop, val)
    if not obj then return false end
    local ok = pcall(function() obj[prop] = val end)
    return ok
end

-- Color3 -> HSV (h in [0,1), s/v in [0,1])
function Utils.rgbToHsv(c)
    local r, g, b = c.R, c.G, c.B
    local max = math.max(r, g, b)
    local min = math.min(r, g, b)
    local d = max - min
    local h = 0
    if d > 0 then
        if max == r then
            h = ((g - b) / d) % 6
        elseif max == g then
            h = (b - r) / d + 2
        else
            h = (r - g) / d + 4
        end
        h = h / 6
    end
    local s = max > 0 and (d / max) or 0
    return h, s, max
end

-- HSV -> Color3
function Utils.hsvToRgb(h, s, v)
    h = h % 1
    s = Utils.clamp(s, 0, 1)
    v = Utils.clamp(v, 0, 1)
    local i = math.floor(h * 6)
    local f = h * 6 - i
    local p = v * (1 - s)
    local q = v * (1 - f * s)
    local t = v * (1 - (1 - f) * s)
    local r, g, b
    if i == 0 then r, g, b = v, t, p
    elseif i == 1 then r, g, b = q, v, p
    elseif i == 2 then r, g, b = p, v, t
    elseif i == 3 then r, g, b = p, q, v
    elseif i == 4 then r, g, b = t, p, v
    else r, g, b = v, p, q end
    return Color3.fromRGB(r * 255, g * 255, b * 255)
end

function Utils.rgbToBytes(c)
    return math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)
end

function Utils.bytesToRgb(r, g, b)
    return Color3.fromRGB(
        Utils.clamp(math.floor(r or 0), 0, 255),
        Utils.clamp(math.floor(g or 0), 0, 255),
        Utils.clamp(math.floor(b or 0), 0, 255)
    )
end

-- Argument normalizer for simplified + advanced syntax
-- Returns normalized options table and callback
-- argMap: list of key names for positional args (e.g. {"Min","Max","Step","Default","Suffix"})
function Utils.normalizeArgs(first, second, ...)
    local argMap = {...}
    local opts, cb
    if type(first) == "string" then
        opts = {}
        cb = second
        if type(cb) ~= "function" then cb = nil end
        opts.Title = first
        opts.Id = Utils.id(argMap.component or "ctrl")
        opts.Description = opts.Description or ""
        -- Map additional positional args
        local n = select('#', ...)
        -- second is already consumed as callback, remaining are in argMap
    elseif type(first) == "table" then
        opts = Utils.deepCopy(first)
        cb = second
        if type(cb) ~= "function" then cb = nil end
        if not opts.Id then opts.Id = Utils.id(argMap.component or "ctrl") end
    else
        opts = { Title = tostring(first), Id = Utils.id(argMap.component or "ctrl") }
        cb = second
    end
    opts.Callback = cb
    return opts, cb
end

